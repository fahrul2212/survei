{
  "name": "stica-reporting-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run cf:types && tsc -b && vite build",
    "preview": "vite preview",
    "cf:types": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example",
    "deploy": "npm run build && wrangler deploy --keep-vars",
    "supabase:link": "supabase link --project-ref ptqdzqxfmtonitflenod",
    "supabase:push": "supabase db push",
    "supabase:functions": "supabase functions deploy",
    "seed:showcase": "node scripts/showcase-seed.mjs",
    "seed:survey-2025": "node scripts/seed-stica-survey-2025.mjs",
    "seed:survey-2025-responses": "node scripts/seed-stica-survey-2025-responses.mjs",
    "db:keep-2025-copy": "node scripts/keep-only-survey-2025-copy.mjs",
    "test:roles": "node scripts/role-smoke-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "clsx": "2.1.1",
    "lucide-react": "1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.10",
    "tailwind-merge": "3.6.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260901.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  }
}
